    day: null,
    package: null,
    packagePrice: null
  };

  // ---- floating support button ----
  document.getElementById('support-btn').addEventListener('click', (e)=>{
    e.preventDefault();
    const msg = encodeURIComponent('مرحباً RAZiN 👋، أحتاج مساعدة .');
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`, '_blank');
