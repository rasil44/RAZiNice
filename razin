<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAZiN — آيسكريم بنكهة الصيف</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+Bhaijaan+2:wght@500;600;700;800&family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --sky:#5B9BD1;
    --sky-deep:#3E7CAE;
    --cream:#FFF8EF;
    --coral:#F27C6B;
    --coral-deep:#E05A47;
    --mint:#8FCB9B;
    --mango:#F5B942;
    --navy:#173B4F;
    --sand:#FCEFD9;
    --white:#FFFFFF;
    --shadow: rgba(23,59,79,0.18);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Tajawal', sans-serif;
    color:var(--navy);
    line-height:1.6;
  }
  h1,h2,h3,.display{
    font-family:'Baloo Bhaijaan 2', sans-serif;
  }
  img{max-width:100%;display:block;}
  button{font-family:inherit;cursor:pointer;}
  a{color:inherit;}

  /* ---------- PAGE / INTRO ---------- */
  #page-bg{
    position:fixed;
    inset:0;
    z-index:-1;
    background:linear-gradient(180deg, #FCEFD9 0%, #FFF8EF 55%);
  }
  .intro-step{
    position:relative;
    overflow:hidden;
    text-align:center;
    padding-top:30px;
  }
  .starfish{
    position:absolute;
    font-size:20px;
    opacity:0.5;
  }
  .logo-img{
    max-width:280px;
    margin:0 auto;
    position:relative;
    z-index:2;
    filter:drop-shadow(0 6px 10px rgba(0,0,0,0.1));
  }
  .tagline{
    color:var(--navy);
    background:#FFFFFF;
    display:inline-block;
    padding:8px 22px;
    border-radius:999px;
    font-weight:700;
    margin-top:6px;
    font-size:14px;
    box-shadow:0 4px 0 rgba(0,0,0,0.06);
    position:relative; z-index:2;
  }

  /* floating support button */
  .support-btn{
    position:fixed;
    bottom:18px;
    left:18px;
    z-index:40;
    display:flex;
    align-items:center;
    gap:8px;
    background:#25D366;
    color:#fff;
    text-decoration:none;
    padding:12px 18px;
    border-radius:999px;
    font-weight:900;
    font-size:13px;
    box-shadow:0 6px 0 #1CAE53;
  }
  .support-btn:active{ transform:translateY(3px); box-shadow:0 2px 0 #1CAE53; }

  /* ---------- SECTIONS ---------- */
  .wrap{ max-width:880px; margin:0 auto; padding:10px 20px 70px; }

  #mini-header{
    position:sticky;
    top:0;
    z-index:20;
    display:flex;
    justify-content:center;
    padding:8px 0;
    margin:0 -20px 6px;
    background:rgba(255,255,255,0.78);
    backdrop-filter:blur(6px);
    -webkit-backdrop-filter:blur(6px);
  }
  #mini-header img{ width:100px; }

  .step{
    background:#FFFCF6;
    border-radius:22px;
    padding:22px 20px;
    margin-bottom:22px;
    box-shadow:0 10px 26px var(--shadow);
    border:2px solid #F0DDBB;
    position:relative;
  }
  .step h2{
    margin:0 0 10px;
    font-size:22px;
    color:var(--coral-deep);
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    text-align:center;
    padding-bottom:12px;
    border-bottom:2px dashed #E3D2AE;
  }
  .step p.hint{
    margin:0 0 16px;
    color:#5b7787;
    font-size:13px;
    text-align:center;
  }

  /* packages */
  .package-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:10px;
  }
  .package-card{
    background:#FFFCF6;
    border:2px dashed #E3D2AE;
    border-radius:14px;
    padding:14px 8px;
    text-align:center;
    position:relative;
    transition:.15s ease;
  }
  .package-card.active{
    background:#FFF3DC;
    border-style:solid;
    border-color:var(--mint);
  }
  .package-card.active::after{
    content:"✓";
    position:absolute; top:8px; left:8px;
    background:var(--mint); color:#fff;
    width:20px;height:20px;border-radius:50%;
    font-size:12px; line-height:20px; font-weight:900;
  }
  .package-name{
    display:block;
    font-size:14px;
    color:var(--coral-deep);
    margin-bottom:6px;
    font-family:'Baloo Bhaijaan 2', sans-serif;
  }
  .package-qty{ font-size:13px; color:var(--navy); margin-bottom:4px; }
  .package-price{ font-size:15px; font-weight:900; color:var(--sky-deep); }
  @media (max-width:420px){
    .package-grid{ grid-template-columns:1fr; }
  }

  /* flavor list (menu style) */
  .flavor-grid{
    display:flex;
    flex-direction:column;
  }
  .flavor-card{
    display:flex;
    align-items:center;
    gap:12px;
    padding:13px 4px;
    border:none;
    border-bottom:1px dashed #E3D2AE;
    border-radius:0;
    background:transparent;
    position:relative;
    transition:.15s ease;
  }
  .flavor-card:last-child{ border-bottom:none; }
  .flavor-card .ball{
    width:32px;height:32px;
    flex-shrink:0;
    border-radius:50%;
    margin:0;
    box-shadow:inset 0 -6px 10px rgba(0,0,0,0.12), 0 3px 0 rgba(0,0,0,0.05);
  }
  .flavor-card b{ font-size:15px; font-weight:700; }
  .flavor-card.active{
    background:#FFF3DC;
    border-radius:12px;
  }
  .flavor-card.active::after{
    content:"✓";
    position:absolute; top:50%; left:10px;
    transform:translateY(-50%);
    background:var(--mint); color:#fff;
    width:22px;height:22px;border-radius:50%;
    font-size:12px; line-height:22px; font-weight:900;
    text-align:center;
  }

  /* addon groups */
  .addon-group{ margin-bottom:16px; }
  .addon-group:last-child{ margin-bottom:0; }
  .addon-title{
    font-size:14px;
    margin:0 0 10px;
    color:var(--sky-deep);
    font-family:'Baloo Bhaijaan 2', sans-serif;
  }
  .chip-grid{ display:flex; flex-wrap:wrap; gap:9px; }
  .chip{
    border:2px dashed #E3D2AE;
    background:#FFFCF6;
    border-radius:999px;
    padding:8px 16px;
    font-size:13px;
    font-weight:700;
    color:var(--navy);
  }
  .chip.active{
    background:var(--mango);
    border-style:solid;
    border-color:var(--mango);
    color:#fff;
  }
  .limit-note{ font-size:12px; color:var(--coral-deep); margin-top:10px; display:none; font-weight:700; }

  /* sold out / fully booked state */
  .disabled{
    opacity:0.45;
    filter:grayscale(0.4);
    pointer-events:none;
  }
  .badge-soldout{
    display:inline-block;
    margin-top:4px;
    margin-inline-start:4px;
    background:var(--coral-deep);
    color:#fff;
    font-size:10px;
    font-weight:900;
    padding:2px 8px;
    border-radius:8px;
    vertical-align:middle;
  }

  /* day picker */
  .day-row{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:4px;}
  .day-chip{
    border:2px dashed #E3D2AE;
    background:#FFFCF6;
    border-radius:12px;
    padding:10px 8px;
    text-align:center;
    flex:1 1 70px;
    font-weight:700;
    font-size:13px;
  }
  .day-chip.active{ background:var(--sky); border-style:solid; border-color:var(--sky); color:#fff; }
  .time-row select{
    width:100%;
    padding:12px 14px;
    border-radius:14px;
    border:2px solid #EAF3FA;
    background:#FAFDFF;
    font-family:inherit;
    font-size:14px;
    color:var(--navy);
    font-weight:700;
  }

  /* details */
  .field{ margin-bottom:14px; }
  .field label{ display:block; font-weight:700; margin-bottom:6px; font-size:14px; }
  .field input, .field textarea{
    width:100%;
    padding:13px 16px;
    border-radius:14px;
    border:2px dashed #E3D2AE;
    background:#FFFCF6;
    font-family:inherit;
    font-size:14px;
    color:var(--navy);
  }
  .field textarea{ resize:vertical; min-height:70px; }

  /* summary */
  .summary{
    background:var(--sand);
    border-radius:22px;
    padding:24px;
    box-shadow:0 12px 30px var(--shadow);
    border-top:3px dashed #E3B97A;
  }
  .summary h3{ margin:0 0 12px; color:var(--coral-deep); font-size:20px; }
  #summary-lines{ font-size:14px; margin-bottom:14px; min-height:22px; }
  #summary-lines .total-line{
    margin-top:10px;
    padding-top:10px;
    border-top:2px dashed #E3B97A;
    font-weight:900;
    font-size:15px;
    color:var(--coral-deep);
  }
  #summary-lines .empty{ color:#8a9aa5; }
  .whatsapp-btn{
    display:flex; align-items:center; justify-content:center; gap:10px;
    width:100%;
    background:#25D366;
    color:#fff;
    border:none;
    padding:16px;
    border-radius:16px;
    font-size:17px;
    font-weight:900;
    box-shadow:0 6px 0 #1CAE53;
  }
  .whatsapp-btn:active{ transform:translateY(3px); box-shadow:0 2px 0 #1CAE53; }
  .warn{
    font-size:12.5px;
    color:var(--coral-deep);
    margin-top:10px;
    text-align:center;
    display:none;
    font-weight:700;
  }

  footer{
    text-align:center;
    padding:26px 20px 40px;
    color:#7c93a0;
    font-size:13px;
  }
  .social-row{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:8px;
    margin-top:14px;
    position:relative;
    z-index:2;
  }
  .social-btn{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:5px 11px;
    border-radius:999px;
    text-decoration:none;
    font-weight:700;
    font-size:11px;
    color:#fff;
    box-shadow:0 3px 0 rgba(0,0,0,0.12);
  }
  .social-btn.instagram{
    background:linear-gradient(135deg, #F5B942 0%, #E05A47 45%, #C13584 75%, #5B51D8 100%);
  }
  .social-btn.tiktok{
    background:#0a0a0a;
  }
  .social-btn.whatsapp{
    background:#25D366;
  }

  @media (max-width:480px){
    .size-grid{ grid-template-columns:repeat(3,1fr); gap:8px; }
    .logo-img{ max-width:250px; }
  }
</style>
</head>
