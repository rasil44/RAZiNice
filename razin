  // flavor selection (single choice)
  document.querySelectorAll('.flavor-card').forEach(card=>{
    card.addEventListener('click', ()=>{
      const flavor = card.dataset.flavor;
      const alreadyActive = card.classList.contains('active');
      document.querySelectorAll('.flavor-card').forEach(c=>c.classList.remove('active'));
      if(alreadyActive){
        state.flavor = null;
      } else {
        card.classList.add('active');
        state.flavor = flavor;
      }
      updateSummary();
    });
  });

  // addon groups: one choice per group (Crunch / Bites / Toppings)
  document.querySelectorAll('.chip-grid[data-group]').forEach(group=>{
    const key = group.dataset.group;
    group.querySelectorAll('.chip').forEach(chip=>{
      chip.addEventListener('click', ()=>{
        const value = chip.dataset.addon;
        const alreadyActive = chip.classList.contains('active');
        group.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
        if(alreadyActive){
          state.addons[key] = null;
        } else {
          chip.classList.add('active');
          state.addons[key] = value;
        }
        updateSummary();
      });
    });
  });

  // day
  document.querySelectorAll('.day-chip').forEach(d=>{
    d.addEventListener('click', ()=>{
      document.querySelectorAll('.day-chip').forEach(x=>x.classList.remove('active'));
      d.classList.add('active');
      state.day = d.dataset.day;
      updateSummary();
    });
  });

  // package (single choice)
  document.querySelectorAll('.package-card').forEach(card=>{
    card.addEventListener('click', ()=>{
      const pkg = card.dataset.package;
      const priceRaw = card.dataset.price;
      const alreadyActive = card.classList.contains('active');
      document.querySelectorAll('.package-card').forEach(c=>c.classList.remove('active'));
      if(alreadyActive){
        state.package = null;
        state.packagePrice = null;
      } else {
        card.classList.add('active');
        state.package = pkg;
        state.packagePrice = priceRaw ? Number(priceRaw) : null;
      }
      updateSummary();
    });
  });

  function getAddonList(){
    return Object.values(state.addons).filter(Boolean);
  }

  function updateSummary(){
    const lines = document.getElementById('summary-lines');
    const addonList = getAddonList();

    if(!state.flavor){
      lines.innerHTML = '<span class="empty">اختر تفاصيل طلبك بالأعلى ليظهر هنا...</span>';
    } else {
      let html = '';
      html += `<div>🍦 النكهة: ${state.flavor}</div>`;
      if(addonList.length) html += `<div>✨ إضافات: ${addonList.join('، ')}</div>`;
      if(state.day) html += `<div>📅 يوم الاستلام: ${state.day}</div>`;
      if(state.package) html += `<div>📦 الباقة: ${state.package}</div>`;
      if(state.package && state.packagePrice){
        const total = state.packagePrice + DELIVERY_FEE;
        html += `<div class="total-line">💰 الإجمالي: ${total} ر.س (شامل التوصيل والترتيب +100 تامين مسترد)</div>`;
      } else if(state.package){
        html += `<div class="total-line">💰 السعر: يُحدد عند التواصل معنا</div>`;
      }
      lines.innerHTML = html;
    }
  }

  document.getElementById('send-btn').addEventListener('click', ()=>{
    if(!state.flavor){
      const warn = document.getElementById('flavor-warn');
      warn.style.display = 'block';
      setTimeout(()=>warn.style.display='none', 2200);
      return;
    }
    const name = document.getElementById('cust-name').value.trim();
    const area = document.getElementById('cust-area').value.trim();
    const note = document.getElementById('cust-note').value.trim();
    const addonList = getAddonList();

    let msg = `مرحباً RAZiN 🍦%0A`;
    msg += `أرغب بطلب:%0A`;
    msg += `- النكهة: ${state.flavor}%0A`;
    if(addonList.length) msg += `- الإضافات: ${addonList.join('، ')}%0A`;
    if(state.day) msg += `- يوم الاستلام: ${state.day}%0A`;
    if(state.package) msg += `- الباقة: ${state.package}%0A`;
    if(state.package && state.packagePrice){
      msg += `- الإجمالي: ${state.packagePrice + DELIVERY_FEE} ر.س (شامل التوصيل والترتيب والتأمين)%0A`;
    } else if(state.package){
      msg += `- السعر: يُحدد عند التواصل معنا%0A`;
    }
    if(name) msg += `- الاسم: ${name}%0A`;
    if(area) msg += `- المنطقة: ${area}%0A`;
    if(note) msg += `- ملاحظات: ${note}`;

    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`;
    window.open(url, '_blank');
  });

  updateSummary();

  // ---- apply sold-out / fully-booked states from AVAILABILITY above ----
  function markUnavailable(el, badgeText){
    el.classList.add('disabled');
    const badge = document.createElement('span');
    badge.className = 'badge-soldout';
    badge.textContent = badgeText;
    el.appendChild(badge);
  }

  document.querySelectorAll('.flavor-card').forEach(card=>{
    if(AVAILABILITY.soldOutFlavors.includes(card.dataset.flavor)){
      markUnavailable(card, 'نفذ');
    }
  });
  document.querySelectorAll('.chip[data-addon]').forEach(chip=>{
    if(AVAILABILITY.soldOutAddons.includes(chip.dataset.addon)){
      markUnavailable(chip, 'نفذ');
    }
  });
  document.querySelectorAll('.day-chip').forEach(day=>{
    if(AVAILABILITY.fullyBookedDays.includes(day.dataset.day)){
      markUnavailable(day, 'محجوز بالكامل');
    }
  });
</script>

</body>
</html>
